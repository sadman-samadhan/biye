# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (for color palette extraction from hero image)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Admin Authentication (no default: admin login is disabled until both are set)
ADMIN_PASSWORD=change-this-to-a-long-passphrase
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
ADMIN_SESSION_SECRET=

# Optional: Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
