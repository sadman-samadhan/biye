# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (for color palette extraction from hero image)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Operators sign in with Supabase Auth. Grant admin with:
#   node --env-file=.env.local scripts/make_admin.mjs you@example.com 'a-long-password'
# Disable public sign-ups in Supabase → Authentication → Providers.

# Salt for hashing visitor IPs in rate-limit keys (any long random string)
IP_HASH_SALT=

# Optional: Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private media storage. Default: a private Supabase bucket (site-media-private).
# Switch to Cloudflare R2 (10 GB free, no bandwidth fees) by setting all of these:
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Guest access secrets (optional: derived from SUPABASE_SERVICE_ROLE_KEY when unset).
# Set them explicitly in production so rotating the Supabase key doesn't sign guests out.
# GUEST_SESSION_SECRET=   # 32+ random characters
# LINK_SIGNING_SECRET=    # 32+ random characters
# PASSCODE_ENC_KEY=       # 32 random bytes, base64
